# Provedor: openrouter | ollama | opencode_go
ZEUS_PROVIDER=opencode_go
ZEUS_MODEL=deepseek-v4-pro

# OpenCode Go
OPENCODE_GO_API_KEY=your_key_here
OPENCODE_GO_BASE_URL=https://api.opencode.co/v1

# OpenRouter
OPENROUTER_API_KEY=your_key_here

# Ollama local
# OLLAMA_HOST=http://localhost:11434

# Provedores LLM adicionais
OPENAI_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here
DEEPSEEK_API_KEY=your_key_here
MISTRAL_API_KEY=your_key_here

# Search APIs (opcional)
SERPER_API_KEY=your_key_here
BRAVE_API_KEY=your_key_here

# Google OAuth (browser auth for Gemini, cheaper than AI Studio API key)
# GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id
# GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret

# Telegram gateway
ZEUS_TELEGRAM_TOKEN=your_bot_token
ZEUS_TELEGRAM_ALLOWED_CHAT_IDS=123456789

# WhatsApp gateway
ZEUS_WHATSAPP_URL=http://127.0.0.1:9877
ZEUS_WHATSAPP_ALLOWED_NUMBERS=5511999999999@s.whatsapp.net

# Discord gateway
ZEUS_DISCORD_TOKEN=your_bot_token
ZEUS_DISCORD_ALLOWED_USER_IDS=123456789
# ZEUS_DISCORD_ALLOWED_CHANNEL_IDS=987654321

# Instagram Messaging API (conta Profissional + webhook HTTPS público)
ZEUS_INSTAGRAM_ACCOUNT_ID=your_instagram_professional_account_id
ZEUS_INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
ZEUS_INSTAGRAM_APP_SECRET=your_meta_app_secret
ZEUS_INSTAGRAM_VERIFY_TOKEN=choose_a_private_verify_token
ZEUS_INSTAGRAM_PUBLIC_WEBHOOK_URL=https://your-domain.example/webhook
ZEUS_INSTAGRAM_HOST=127.0.0.1
ZEUS_INSTAGRAM_PORT=8765
ZEUS_INSTAGRAM_API_VERSION=v26.0

# Permissões de execução do Zeus
# ZEUS_EXECUTION_PERMISSION=sandbox_only  # apenas execute_python/script na sandbox
ZEUS_EXECUTION_PERMISSION=allow  # permite run_terminal no host
# ZEUS_FILE_PERMISSION=read_only
# ZEUS_FILE_PERMISSION=project_only
ZEUS_FILE_PERMISSION=unrestricted

# Segurança: token de autenticação para o sandbox Go (recomendado)
# Gere com: openssl rand -hex 32
# ZEUS_SANDBOX_AUTH_TOKEN=your_sandbox_token_here

# Segurança: token de autenticação para o MCP server (opcional)
# ZEUS_MCP_AUTH_TOKEN=your_mcp_token_here
