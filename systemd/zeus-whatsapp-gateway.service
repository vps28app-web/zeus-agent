[Unit]
Description=Zeus WhatsApp Gateway
After=network.target zeus-whatsapp-bridge.service
Wants=zeus-whatsapp-bridge.service

[Service]
Type=simple
ExecStart=/home/vps28/Documentos/Dev/Zeus/.venv/bin/python -m zeus.gateway --platform whatsapp
Environment="ZEUS_GATEWAY_PLATFORM=whatsapp"
Environment="ZEUS_HOME=/home/vps28/.zeus"
EnvironmentFile=/home/vps28/.zeus/.env
WorkingDirectory=/home/vps28/Documentos/Dev/Zeus
Restart=always
RestartSec=10
User=vps28
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zeus-whatsapp-gateway

[Install]
WantedBy=multi-user.target
