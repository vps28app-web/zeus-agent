[Unit]
Description=Zeus Telegram Gateway
After=network.target zeus-sandbox.service
Wants=zeus-sandbox.service

[Service]
Type=simple
ExecStart=/home/vps28/Documentos/Dev/Zeus/.venv/bin/python -m zeus.gateway --platform telegram
Environment="ZEUS_GATEWAY_PLATFORM=telegram"
EnvironmentFile=/home/vps28/.zeus/.env
WorkingDirectory=/home/vps28/Documentos/Dev/Zeus
Restart=always
RestartSec=10
User=vps28
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zeus-telegram-gateway

[Install]
WantedBy=multi-user.target
