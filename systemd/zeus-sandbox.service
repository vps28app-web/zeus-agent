[Unit]
Description=Zeus Agent Harness Sandbox
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/zeus/sandbox.env
ExecStart=/usr/local/lib/zeus/sandbox -addr 127.0.0.1:9876
Restart=always
RestartSec=5
User=root
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zeus-sandbox

[Install]
WantedBy=multi-user.target
